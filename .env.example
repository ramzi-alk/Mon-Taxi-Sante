# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
VITE_APP_URL=https://mon-taxi-sante.com
VITE_APP_NAME="Mon Taxi Santé"

# Cloudflare Turnstile (anti-bot pour la récupération de réservation)
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Resend (envoi des emails transactionnels : confirmation de réservation,
# annulation, approbation chauffeur, alerte admin nouvelle candidature)
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL="Mon Taxi Santé <reservations@mon-taxi-sante.com>"
ADMIN_NOTIFICATION_EMAIL=contact@mon-taxi-sante.com

# Vercel Cron (rappel veille de course, voir vercel.json + api/cron/booking-reminders) :
# secret partagé vérifié dans le header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your-cron-secret

# Mapbox (recherche d'adresses + POI, distance routière réelle — voir src/lib/mapbox.ts)
# Token public (pk.xxx) : restreignez-le aux URL de votre site dans le dashboard Mapbox.
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token
