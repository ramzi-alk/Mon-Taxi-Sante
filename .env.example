# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
VITE_APP_URL=https://mon-taxi-sante.com
VITE_APP_NAME="Docteur Taxi"

# Panel admin (voir src/lib/adminAccess.ts) : liste blanche d'emails
# autorisés à accéder à /admin, en plus de profiles.role = 'admin'. Les
# deux conditions doivent être vraies. Si la variable est absente/vide,
# seul le rôle DB est vérifié (comportement historique) — à configurer en
# production pour activer cette seconde barrière. Emails séparés par une
# virgule, insensible à la casse.
ADMIN_EMAILS=admin1@mon-taxi-sante.com,admin2@mon-taxi-sante.com

# Cloudflare Turnstile (anti-bot pour la récupération de réservation)
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Resend (envoi des emails transactionnels : confirmation de réservation,
# annulation, approbation chauffeur, alerte admin nouvelle candidature)
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL="Docteur Taxi <reservations@mon-taxi-sante.com>"
ADMIN_NOTIFICATION_EMAIL=contact@mon-taxi-sante.com

# Vercel Cron (rappel veille de course, voir vercel.json + api/cron/booking-reminders) :
# secret partagé vérifié dans le header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your-cron-secret

# Mapbox (recherche d'adresses + POI, distance routière réelle — voir src/lib/mapbox.ts)
# Token public (pk.xxx) : restreignez-le aux URL de votre site dans le dashboard Mapbox.
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token

# Web Push (notifications push chauffeur — voir src/server/push.ts)
# Générer avec : node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(JSON.stringify(k))"
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Doit être une adresse mailto: ou une URL https: identifiant l'opérateur du service
VAPID_EMAIL=mailto:contact@mon-taxi-sante.com
